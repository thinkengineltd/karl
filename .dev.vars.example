# Optional local Worker secrets. Copy to .dev.vars and keep it out of Git.
# npm run dev reads these two values; Base Code secrets with the same names also work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# npm run dev configures its own loopback-only development identity and local storage.
# For shared previews, set HOST, PORT, PREVIEW_PASSWORD and optionally PREVIEW_ORIGIN
# in the process environment (Base Code secrets/settings), not in this file.
